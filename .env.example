# 复制为 .env 后填写本机专用随机值；不要直接使用示例占位符。
POSTGRES_DB="workorder_resource"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
DATABASE_URL="postgresql://postgres:URL_ENCODED_PASSWORD@localhost:5432/workorder_resource?schema=public"
# Web 服务连接池。单实例默认 10；多副本部署时应确保 副本数×连接数 不超过 PostgreSQL 上限。
DB_CONNECTION_LIMIT="10"
DB_POOL_TIMEOUT_SECONDS="10"
DB_CONNECT_TIMEOUT_SECONDS="10"
# 只记录模型、操作和耗时，不记录 SQL 参数或业务数据。
DB_SLOW_QUERY_MS="750"
SESSION_SECRET=""
# v1.29.1 正常扫码报工不再使用 PIN；仅在维护旧版 PIN 数据时填写独立 pepper。
# 如需维护旧数据，至少 32 位且不得复用 SESSION_SECRET。
FIELD_REPORT_PIN_PEPPER=""
DAILY_PLAN_ENABLED="true"
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="workorder-resources"
S3_ACCESS_KEY_ID="local-minio-admin"
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
S3_MAX_ATTEMPTS="3"
APP_BASE_URL="http://localhost:3000"
MAX_UPLOAD_SIZE_MB="50"
# 企业微信群消息推送（原群机器人）的完整 Webhook，仅在服务端使用。
# 请作为 Sealos 密钥环境变量保存，不要提交真实地址到代码仓库。
WECOM_ROBOT_WEBHOOK_URL=""
# 质量通知使用上述群机器人。正式部署 APP_BASE_URL 必须为 HTTPS 站点根地址。
# 默认镜像入口自动启动持久通知队列；不要用 next dev 或覆盖启动命令代替。
# 派单人员的系统账号需绑定人事记录，手机号须与企微群成员一致且通知开关开启。
SEED_ADMIN_USERNAME="admin"
# 仅首次创建管理员或 SEED_RESET_ADMIN_PASSWORD=true 时填写。
# 至少 8 位，不得为常见密码、重复字符或包含完整登录账号；成功后应从环境中移除。
SEED_ADMIN_PASSWORD=""
SEED_RESET_ADMIN_PASSWORD="false"
SEED_SAMPLE_WORK_ORDERS="false"
