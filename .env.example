# 复制为 .env 后填写本机专用随机值；不要直接使用示例占位符。
POSTGRES_DB="workorder_resource"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
DATABASE_URL="postgresql://postgres:URL_ENCODED_PASSWORD@localhost:5432/workorder_resource?schema=public"
SESSION_SECRET=""
# 共享终端 PIN 独立 pepper，至少 32 位随机字符串；不得复用 SESSION_SECRET。
# 更换后现有 PIN 将无法验证，必须由管理员逐一重置。
FIELD_REPORT_PIN_PEPPER=""
DAILY_PLAN_ENABLED="true"
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="workorder-resources"
S3_ACCESS_KEY_ID="local-minio-admin"
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
APP_BASE_URL="http://localhost:3000"
MAX_UPLOAD_SIZE_MB="50"
# 企业微信群消息推送（原群机器人）的完整 Webhook，仅在服务端使用。
# 请作为 Sealos 密钥环境变量保存，不要提交真实地址到代码仓库。
WECOM_ROBOT_WEBHOOK_URL=""
SEED_ADMIN_USERNAME="admin"
# 仅首次创建管理员或 SEED_RESET_ADMIN_PASSWORD=true 时填写。
# 至少 8 位，不得为常见密码、重复字符或包含完整登录账号；成功后应从环境中移除。
SEED_ADMIN_PASSWORD=""
SEED_RESET_ADMIN_PASSWORD="false"
SEED_SAMPLE_WORK_ORDERS="false"
