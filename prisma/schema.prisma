  planOrderId String?              @map("plan_order_id")
  batchId     String?              @map("batch_id")
  action      String
  beforeData  Json?                @map("before_data")
  afterData   Json?                @map("after_data")
  impactData  Json?                @map("impact_data")
  reason      String?
  actorId     String?              @map("actor_id")
  createdAt   DateTime             @default(now()) @map("created_at")
  planOrder   ProductionPlanOrder? @relation(fields: [planOrderId], references: [id], onDelete: Cascade)
  batch       ProductionPlanBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  actor       User?                @relation("ProductionPlanChangeActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([planOrderId, createdAt])
  @@index([batchId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@map("production_plan_changes")
}

model ProductProcessTimeEntry {
  id                  String                 @id @default(uuid())
  profileId           String                 @map("profile_id")
  processDefinitionId String                 @map("process_definition_id")
  position            Int
  sequenceGroup       Int                    @default(1) @map("sequence_group")
  timeBasis           String                 @default("per_unit") @map("time_basis")
  unitMilliseconds    Int                    @map("unit_milliseconds")
  actionMilliseconds  Int?                   @map("action_milliseconds")
  occurrences         Int                    @default(1)
  setupMilliseconds   Int                    @default(0) @map("setup_milliseconds")
  unitLabel           String                 @default("件") @map("unit_label")
  countsForEfficiency Boolean                @default(true) @map("counts_for_efficiency")
  remark              String?
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  profile             ProductTimeProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  processDefinition   ProcessDefinition      @relation(fields: [processDefinitionId], references: [id], onDelete: Restrict)
  routeSteps          WorkOrderProcessStep[]

  @@unique([profileId, processDefinitionId])
  @@unique([profileId, position])
  @@index([processDefinitionId])
  @@map("product_process_time_entries")
}

model DrawingLibraryFile {
  id                          String              @id @default(uuid())
  libraryItemId               String              @map("library_item_id")
  categoryId                  String              @map("category_id")
  originalName                String              @map("original_name")
  displayName                 String?             @map("display_name")
  mimeType                    String              @map("mime_type")
  size                        Int
  version                     String              @default("V1.0")
  objectKey                   String              @map("object_key")
  uploadedById                String?             @map("uploaded_by")
  sourceResourceFileId        String?             @unique @map("source_resource_file_id")
  sourceSopVersionId          String?             @unique @map("source_sop_version_id")
  sourcePdfOverlayVersionId   String?             @unique @map("source_pdf_overlay_version_id")
  supersedesFileId            String?             @unique @map("supersedes_file_id")
  isCurrent                   Boolean             @default(true) @map("is_current")
  remark                      String?
  deletedAt                   DateTime?           @map("deleted_at")
  createdAt                   DateTime            @default(now()) @map("created_at")
  updatedAt                   DateTime            @updatedAt @map("updated_at")
  libraryItem                 DrawingLibraryItem  @relation(fields: [libraryItemId], references: [id], onDelete: Cascade)
  category                    ResourceCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  uploadedBy                  User?               @relation("UploadedDrawingLibraryFiles", fields: [uploadedById], references: [id], onDelete: SetNull)
  sourceResourceFile          ResourceFile?       @relation("DrawingLibraryFileSource", fields: [sourceResourceFileId], references: [id], onDelete: SetNull)
  sourceSopVersion            SopVersion?         @relation("SopVersionPublishedFile", fields: [sourceSopVersionId], references: [id], onDelete: SetNull)
  sourcePdfOverlayVersion     PdfOverlayVersion?  @relation("PdfOverlayVersionPublishedFile", fields: [sourcePdfOverlayVersionId], references: [id], onDelete: SetNull)
  sourceForPdfOverlayVersions PdfOverlayVersion[] @relation("PdfOverlayVersionSourceFile")
  pdfOverlayBaseFor           PdfOverlayDocument? @relation("PdfOverlayBaseFile")
  pdfOverlayCurrentFor        PdfOverlayDocument? @relation("PdfOverlayCurrentFile")
  supersedesFile              DrawingLibraryFile? @relation("DrawingLibraryFileSupersession", fields: [supersedesFileId], references: [id], onDelete: SetNull)
  supersededByFile            DrawingLibraryFile? @relation("DrawingLibraryFileSupersession")

  @@index([libraryItemId])
  @@index([categoryId])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([version])
  @@index([objectKey])
  @@index([libraryItemId, categoryId, isCurrent, deletedAt])
  @@index([supersedesFileId])
  @@map("drawing_library_files")
}

model OperationLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("operation_logs")
}

model Issue {
  id                 String              @id @default(uuid())
  sequence           Int                 @unique @default(autoincrement())
  title              String
  type               String              @default("production")
  priority           String              @default("normal")
  status             String              @default("pending")
  description        String?
  sourceType         String?             @map("source_type")
  sourceId           String?             @map("source_id")
  sourceCode         String?             @map("source_code")
  sourceRoute        String?             @map("source_route")
  sourceAlertCode    String?             @map("source_alert_code")
  sourceFingerprint  String?             @unique @map("source_fingerprint")
  workOrderId        String?             @map("work_order_id")
  reporterId         String?             @map("reporter_id")
  assigneeId         String?             @map("assignee_id")
  assigneeEmployeeId String?             @map("assignee_employee_id")
  dueAt              DateTime?           @map("due_at")
  processName        String?             @map("process_name")
  affectedQuantity   Int?                @map("affected_quantity")
  temporaryMeasure   String?             @map("temporary_measure")
  rootCause          String?             @map("root_cause")
  solution           String?
  verificationResult String?             @map("verification_result")
  resolvedAt         DateTime?           @map("resolved_at")
  verifiedAt         DateTime?           @map("verified_at")
  closedAt           DateTime?           @map("closed_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  workOrder          WorkOrder?          @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  reporter           User?               @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignee           User?               @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeEmployee   Employee?           @relation("IssueEmployeeAssignee", fields: [assigneeEmployeeId], references: [id], onDelete: SetNull)
  collaborators      IssueCollaborator[]
  activities         IssueActivity[]
  attachments        IssueAttachment[]
  changeRequests     ChangeRequest[]

  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([assigneeId])
  @@index([assigneeEmployeeId])
  @@index([reporterId])
  @@index([workOrderId])
  @@index([sourceType, sourceId])
  @@index([dueAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("issues")
}

model IssueCollaborator {
  id         String   @id @default(uuid())
  issueId    String   @map("issue_id")
  employeeId String   @map("employee_id")
  createdAt  DateTime @default(now()) @map("created_at")
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([issueId, employeeId])
  @@index([employeeId])
  @@map("issue_collaborators")
}

model IssueActivity {
  id         String   @id @default(uuid())
  issueId    String   @map("issue_id")
  action     String
  content    String?
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  actorId    String?  @map("actor_id")
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at")
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor      User?    @relation("IssueActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
  @@index([actorId])
  @@index([action])
  @@map("issue_activities")
}

model IssueAttachment {
  id           String    @id @default(uuid())
  issueId      String    @map("issue_id")
  objectKey    String    @unique @map("object_key")
  originalName String    @map("original_name")
  displayName  String?   @map("display_name")
  mimeType     String    @map("mime_type")
  fileType     String    @map("file_type")
  size         BigInt
  uploadedById String?   @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  issue        Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploadedBy   User?     @relation("IssueAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("issue_attachments")
}

model ChangeRequest {
  id                   String             @id @default(uuid())
  sequence             Int                @unique @default(autoincrement())
  title                String
  type                 String             @default("drawing")
  priority             String             @default("normal")
  status               String             @default("draft")
  reason               String?
  description          String?
  impactAreas          String[]           @default([]) @map("impact_areas")
  impactScope          String?            @map("impact_scope")
  implementationPlan   String?            @map("implementation_plan")
  implementationResult String?            @map("implementation_result")
  validationResult     String?            @map("validation_result")
  rollbackPlan         String?            @map("rollback_plan")
  sourceIssueId        String?            @map("source_issue_id")
  workOrderId          String?            @map("work_order_id")
  requesterId          String?            @map("requester_id")
  ownerId              String?            @map("owner_id")
  dueAt                DateTime?          @map("due_at")
  effectiveAt          DateTime?          @map("effective_at")
  version              Int                @default(0)
  closedAt             DateTime?          @map("closed_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  deletedAt            DateTime?          @map("deleted_at")
  sourceIssue          Issue?             @relation(fields: [sourceIssueId], references: [id], onDelete: SetNull)
  workOrder            WorkOrder?         @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  requester            User?              @relation("ChangeRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  owner                User?              @relation("ChangeOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities           ChangeActivity[]
  attachments          ChangeAttachment[]

  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([ownerId])
  @@index([requesterId])
  @@index([workOrderId])
  @@index([sourceIssueId])
  @@index([dueAt])
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("change_requests")
}

model ChangeActivity {
  id              String        @id @default(uuid())
  changeRequestId String        @map("change_request_id")
  action          String
