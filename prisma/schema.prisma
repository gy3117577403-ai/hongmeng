model KnowledgeArticle {
  id            String                @id @default(uuid())
  sequence      Int                   @unique @default(autoincrement())
  title         String
  category      String                @default("general")
  status        String                @default("published")
  summary       String?
  content       String                @db.Text
  tags          String[]              @default([])
  customerName  String?               @map("customer_name")
  specification String?
  productModel  String?               @map("product_model")
  version       Int                   @default(1)
  createdById   String?               @map("created_by_id")
  updatedById   String?               @map("updated_by_id")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  deletedAt     DateTime?             @map("deleted_at")
  createdBy     User?                 @relation("KnowledgeArticleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?                 @relation("KnowledgeArticleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  attachments   KnowledgeAttachment[]
  relations     KnowledgeRelation[]

  @@index([category])
  @@index([status])
  @@index([customerName])
  @@index([specification])
  @@index([productModel])
  @@index([updatedAt])
  @@index([deletedAt])
