  expiresAt      DateTime?              @map("expires_at")
  revokedAt      DateTime?              @map("revoked_at")
  lastAccessedAt DateTime?              @map("last_accessed_at")
  createdBy      String?                @map("created_by")
  createdAt      DateTime               @default(now()) @map("created_at")
  site           CapabilityShowcaseSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, revokedAt, createdAt])
  @@index([expiresAt])
  @@map("capability_showcase_shares")
}

model TrainingCourse {
  id                     String               @id @default(uuid())
  code                   String               @unique
  name                   String
  category               String               @default("岗位技能")
  objective              String?
  description            String?
  targetAudience         String?              @map("target_audience")
  defaultDurationMinutes Int                  @default(60) @map("default_duration_minutes")
  mode                   String               @default("OFFLINE")
  isRequired             Boolean              @default(false) @map("is_required")
  assessmentMode         String               @default("NONE") @map("assessment_mode")
  passScore              Int?                 @map("pass_score")
  skillId                String?              @map("skill_id")
  targetLevel            Int?                 @map("target_level")
  validityMonths         Int?                 @map("validity_months")
  retrainingMonths       Int?                 @map("retraining_months")
  ownerEmployeeId        String?              @map("owner_employee_id")
  status                 String               @default("ACTIVE")
  version                Int                  @default(1)
  createdById            String?              @map("created_by_id")
  updatedById            String?              @map("updated_by_id")
  deletedAt              DateTime?            @map("deleted_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  skill                  SkillDefinition?     @relation(fields: [skillId], references: [id], onDelete: SetNull)
  plans                  TrainingPlan[]
  attachments            TrainingAttachment[]

  @@index([status, deletedAt, updatedAt])
  @@index([category, status])
  @@index([skillId])
  @@index([ownerEmployeeId])
  @@map("training_courses")
}

model TrainingPlan {
  id               String                @id @default(uuid())
  code             String                @unique
  title            String
  courseId         String?               @map("course_id")
  courseVersion    Int?                  @map("course_version")
  courseSnapshot   Json?                 @map("course_snapshot")
  purpose          String?
  scopeType        String                @default("SELECTED") @map("scope_type")
  scopeDescription String?               @map("scope_description")
  organizerId      String?               @map("organizer_id")
  trainerId        String?               @map("trainer_id")
  reviewerId       String?               @map("reviewer_id")
  departmentId     String?               @map("department_id")
  startAt          DateTime              @map("start_at")
  endAt            DateTime              @map("end_at")
  location         String?
  mode             String                @default("OFFLINE")
  isRequired       Boolean               @default(false) @map("is_required")
  assessmentMode   String                @default("NONE") @map("assessment_mode")
  passScore        Int?                  @map("pass_score")
  status           String                @default("DRAFT")
  publishedAt      DateTime?             @map("published_at")
  startedAt        DateTime?             @map("started_at")
  submittedAt      DateTime?             @map("submitted_at")
  completedAt      DateTime?             @map("completed_at")
  cancelledAt      DateTime?             @map("cancelled_at")
  cancelReason     String?               @map("cancel_reason")
  archivedAt       DateTime?             @map("archived_at")
  archivedById     String?               @map("archived_by_id")
  archiveReason    String?               @map("archive_reason")
  version          Int                   @default(1)
  createdById      String?               @map("created_by_id")
  updatedById      String?               @map("updated_by_id")
  deletedById      String?               @map("deleted_by_id")
  deleteReason     String?               @map("delete_reason")
  deletedAt        DateTime?             @map("deleted_at")
  restoredAt       DateTime?             @map("restored_at")
  restoredById     String?               @map("restored_by_id")
  restoreReason    String?               @map("restore_reason")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  course           TrainingCourse?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  sessions         TrainingSession[]
  participants     TrainingParticipant[]
  attachments      TrainingAttachment[]
  activities       TrainingActivity[]

  @@index([status, startAt, deletedAt])
  @@index([archivedAt, status, deletedAt])
  @@index([courseId])
  @@index([departmentId, startAt])
  @@index([trainerId, startAt])
  @@index([reviewerId, status])
  @@map("training_plans")
}

model TrainingSession {
  id                    String                      @id @default(uuid())
  planId                String                      @map("plan_id")
  name                  String
  sequence              Int                         @default(1)
  startAt               DateTime                    @map("start_at")
  endAt                 DateTime                    @map("end_at")
  location              String?
  trainerId             String?                     @map("trainer_id")
  status                String                      @default("SCHEDULED")
  actualStartAt         DateTime?                   @map("actual_start_at")
  actualEndAt           DateTime?                   @map("actual_end_at")
  actualMinutes         Int?                        @map("actual_minutes")
  checkInOpenMinutes    Int                         @default(30) @map("check_in_open_minutes")
  lateAfterMinutes      Int                         @default(5) @map("late_after_minutes")
  checkInCloseMinutes   Int                         @default(15) @map("check_in_close_minutes")
  feedbackDeadlineHours Int                         @default(24) @map("feedback_deadline_hours")
  feedbackRequired      Boolean                     @default(false) @map("feedback_required")
  notes                 String?
  version               Int                         @default(1)
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")
  plan                  TrainingPlan                @relation(fields: [planId], references: [id], onDelete: Cascade)
  attachments           TrainingAttachment[]
  qrWindows             TrainingQrWindow[]
  attendanceRecords     TrainingSessionAttendance[]
  feedbacks             TrainingFeedback[]

  @@unique([planId, sequence])
  @@index([startAt, status])
  @@index([trainerId, startAt])
  @@map("training_sessions")
}

model TrainingParticipant {
  id                   String                      @id @default(uuid())
  planId               String                      @map("plan_id")
  employeeId           String                      @map("employee_id")
  employeeNoSnapshot   String                      @map("employee_no_snapshot")
  employeeNameSnapshot String                      @map("employee_name_snapshot")
  departmentSnapshot   String?                     @map("department_snapshot")
  positionSnapshot     String?                     @map("position_snapshot")
  teamSnapshot         String?                     @map("team_snapshot")
  isRequired           Boolean                     @default(false) @map("is_required")
  attendanceStatus     String                      @default("INVITED") @map("attendance_status")
  checkInAt            DateTime?                   @map("check_in_at")
  checkOutAt           DateTime?                   @map("check_out_at")
  actualMinutes        Int?                        @map("actual_minutes")
  theoryScore          Int?                        @map("theory_score")
  practicalScore       Int?                        @map("practical_score")
  score                Int?
  result               String                      @default("PENDING")
  status               String                      @default("INVITED")
  reviewStatus         String                      @default("NOT_REQUIRED") @map("review_status")
  reviewerId           String?                     @map("reviewer_id")
  reviewComment        String?                     @map("review_comment")
  absenceNote          String?                     @map("absence_note")
  certificationId      String?                     @map("certification_id")
  submittedAt          DateTime?                   @map("submitted_at")
  reviewedAt           DateTime?                   @map("reviewed_at")
  version              Int                         @default(1)
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")
  plan                 TrainingPlan                @relation(fields: [planId], references: [id], onDelete: Cascade)
  employee             Employee                    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attachments          TrainingAttachment[]
  sessionAttendances   TrainingSessionAttendance[]
  feedbacks            TrainingFeedback[]

  @@unique([planId, employeeId])
  @@index([employeeId, status])
  @@index([reviewStatus, updatedAt])
  @@index([attendanceStatus, updatedAt])
  @@map("training_participants")
}

model TrainingQrWindow {
  id                String                      @id @default(uuid())
  sessionId         String                      @map("session_id")
  purpose           String
  status            String                      @default("OPEN")
  tokenHash         String                      @unique @map("token_hash")
  generation        Int                         @default(1)
  opensAt           DateTime                    @map("opens_at")
  expiresAt         DateTime                    @map("expires_at")
  openedAt          DateTime                    @default(now()) @map("opened_at")
  closedAt          DateTime?                   @map("closed_at")
  openedById        String                      @map("opened_by_id")
  closedById        String?                     @map("closed_by_id")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  session           TrainingSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attendanceRecords TrainingSessionAttendance[]

  @@index([sessionId, purpose, status])
  @@index([expiresAt, status])
  @@map("training_qr_windows")
}

model TrainingSessionAttendance {
  id               String              @id @default(uuid())
  sessionId        String              @map("session_id")
  participantId    String              @map("participant_id")
  status           String              @default("INVITED")
  checkInAt        DateTime?           @map("check_in_at")
  checkOutAt       DateTime?           @map("check_out_at")
  source           String              @default("SYSTEM_INVITE")
  qrWindowId       String?             @map("qr_window_id")
  correctedAt      DateTime?           @map("corrected_at")
  correctedById    String?             @map("corrected_by_id")
  correctionReason String?             @map("correction_reason")
  version          Int                 @default(1)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  session          TrainingSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant      TrainingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  qrWindow         TrainingQrWindow?   @relation(fields: [qrWindowId], references: [id], onDelete: SetNull)

  @@unique([sessionId, participantId])
  @@index([participantId, status])
  @@index([sessionId, status, checkInAt])
  @@index([qrWindowId])
  @@map("training_session_attendances")
}

model TrainingFeedback {
  id                   String              @id @default(uuid())
  sessionId            String              @map("session_id")
  participantId        String              @map("participant_id")
  overallRating        Int                 @map("overall_rating")
  contentRating        Int                 @map("content_rating")
  trainerRating        Int                 @map("trainer_rating")
  practicalValueRating Int                 @map("practical_value_rating")
  issueTags            Json                @map("issue_tags")
  comment              String?
  followUpRequested    Boolean             @default(false) @map("follow_up_requested")
  submittedAt          DateTime            @default(now()) @map("submitted_at")
  version              Int                 @default(1)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  session              TrainingSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant          TrainingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([sessionId, participantId])
  @@index([sessionId, submittedAt])
  @@index([participantId, updatedAt])
  @@index([followUpRequested, updatedAt])
  @@map("training_feedbacks")
}

model TrainingAttachment {
  id            String               @id @default(uuid())
  courseId      String?              @map("course_id")
  planId        String?              @map("plan_id")
  sessionId     String?              @map("session_id")
  participantId String?              @map("participant_id")
  kind          String               @default("OTHER")
  objectKey     String               @unique @map("object_key")
  originalName  String               @map("original_name")
  displayName   String?              @map("display_name")
  mimeType      String               @map("mime_type")
  size          BigInt
  uploadedById  String?              @map("uploaded_by_id")
  deletedAt     DateTime?            @map("deleted_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  course        TrainingCourse?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  plan          TrainingPlan?        @relation(fields: [planId], references: [id], onDelete: Cascade)
  session       TrainingSession?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant   TrainingParticipant? @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([courseId, deletedAt, createdAt])
  @@index([planId, deletedAt, createdAt])
  @@index([sessionId, deletedAt, createdAt])
  @@index([participantId, deletedAt, createdAt])
  @@map("training_attachments")
}

model TrainingActivity {
  id         String       @id @default(uuid())
  planId     String       @map("plan_id")
  action     String
  fromStatus String?      @map("from_status")
  toStatus   String?      @map("to_status")
  content    String?
  detail     Json?
  actorId    String?      @map("actor_id")
  createdAt  DateTime     @default(now()) @map("created_at")
  plan       TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
  @@index([actorId, createdAt])
  @@map("training_activities")
}
