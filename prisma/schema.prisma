  @@index([articleId, createdAt])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("knowledge_attachments")
}

model KnowledgeRelation {
  id          String           @id @default(uuid())
  articleId   String           @map("article_id")
  sourceType  String           @map("source_type")
  sourceId    String           @map("source_id")
  sourceLabel String?          @map("source_label")
  sourceHref  String?          @map("source_href")
  createdAt   DateTime         @default(now()) @map("created_at")
  article     KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, sourceType, sourceId])
  @@index([sourceType, sourceId])
  @@index([createdAt])
  @@map("knowledge_relations")
}

model ConnectorParameter {
  id                     String                           @id @default(cuid())
  rowNo                  Int?                             @map("row_no")
  model                  String?
  outerPeelMm            String?                          @map("outer_peel_mm")
  innerPeelMm            String?                          @map("inner_peel_mm")
  insertionLengthMm      String?                          @map("insertion_length_mm")
  remark                 String?
  isHighlighted          Boolean                          @default(false) @map("is_highlighted")
  createdBy              String?                          @map("created_by")
  updatedBy              String?                          @map("updated_by")
  createdAt              DateTime                         @default(now()) @map("created_at")
  updatedAt              DateTime                         @updatedAt @map("updated_at")
  deletedAt              DateTime?                        @map("deleted_at")
  importBatchId          String?                          @map("import_batch_id")
  importBatch            ConnectorParameterImportBatch?   @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  assemblyManualBindings ConnectorAssemblyManualBinding[]

  @@index([rowNo])
  @@index([model])
  @@index([isHighlighted])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([importBatchId])
  @@map("connector_parameters")
}

model ConnectorAssemblyManual {
  id           String                              @id @default(cuid())
  title        String
  manufacturer String?
  family       String?
  documentNo   String?                             @map("document_no")
  summary      String?
  keywords     String?
  createdBy    String?                             @map("created_by")
  deletedAt    DateTime?                           @map("deleted_at")
  createdAt    DateTime                            @default(now()) @map("created_at")
  updatedAt    DateTime                            @updatedAt @map("updated_at")
  versions     ConnectorAssemblyManualVersion[]
  bindings     ConnectorAssemblyManualBinding[]
  importItems  ConnectorAssemblyManualImportItem[]

  @@index([title])
  @@index([manufacturer])
  @@index([family])
  @@index([documentNo])
  @@index([deletedAt])
  @@index([updatedAt])
  @@map("connector_assembly_manuals")
}

model ConnectorAssemblyManualVersion {
  id            String                              @id @default(cuid())
  manualId      String                              @map("manual_id")
  revision      String
  issuedAt      DateTime?                           @map("issued_at")
  pageCount     Int?                                @map("page_count")
  fileMode      String                              @map("file_mode")
  isLatest      Boolean                             @default(false) @map("is_latest")
  status        String?
  tocJson       Json?                               @map("toc_json")
  searchText    String?                             @map("search_text") @db.Text
  detectedTitle String?                             @map("detected_title")
  parseStatus   String?                             @map("parse_status")
  parseWarnings Json?                               @map("parse_warnings")
  remark        String?
  createdBy     String?                             @map("created_by")
  deletedAt     DateTime?                           @map("deleted_at")
  createdAt     DateTime                            @default(now()) @map("created_at")
  updatedAt     DateTime                            @updatedAt @map("updated_at")
